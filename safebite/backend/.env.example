# Copy this file to .env and adjust if needed.

# PostgreSQL connection. This default works with a Homebrew Postgres
# install after running:  createdb safebite
DATABASE_URL=postgresql://localhost/safebite

# No Postgres set up yet? Uncomment this line instead to use a local
# SQLite file for today's demo (switch back to Postgres later):
# DATABASE_URL=sqlite:///safebite_dev.db

# Secret used to sign login tokens. Any long random string works.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string

PORT=5001

